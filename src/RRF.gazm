;
;******ROBOT GAME...... R G .......
;
RGORG: equ $26C0
PLAYER:         equ RGORG + 0
RANDXY:         equ RGORG + 3
CKOBS:          equ RGORG + 6
MANDSP:         equ RGORG + 9
STRT1:          equ RGORG + 12
STRT2:          equ RGORG + 15
TDISPV:         equ RGORG + 18
MANPIC:         equ RGORG + 21
LASPIC:         equ RGORG + 23
