MPCTON:         equ ROSORG + 144
BLKON:          equ ROSORG + 147
EXECV:          equ ROSORG + 150
P1SW:           equ ROSORG + 153
P2SW:           equ ROSORG + 156
DIVAB:          equ ROSORG + 159
RCMOSA:         equ ROSORG + 162
RCMOSB:         equ ROSORG + 165
RCMOSD:         equ ROSORG + 168
WCMOSA:         equ ROSORG + 171
WCMOSB:         equ ROSORG + 174
WCMOSD:         equ ROSORG + 177
BCDBIN:         equ ROSORG + 180
RWMOVE:         equ ROSORG + 183
AUD:            equ ROSORG + 186
AUD1:           equ ROSORG + 189
INT20V:         equ ROSORG + 192
LFV:            equ ROSORG + 195
NEWBCH:         equ ROSORG + 198
;
;PLAYER DEATH
;
RDORG: equ $DD00
RDTHV:          equ RDORG + 0
;
;HUMANS+HULKS
;
RHORG: equ $0000
HULKST:         equ RHORG + 0
