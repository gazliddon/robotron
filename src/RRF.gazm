DMAON:          equ ROSORG + 24
BLKCLR:         equ ROSORG + 27
PCTOFF:         equ ROSORG + 30
PCTON:          equ ROSORG + 33
COLST:          equ ROSORG + 36
COL0:           equ ROSORG + 39
HEXBCD:         equ ROSORG + 42
BCDHEX:         equ ROSORG + 45
OINIT:          equ ROSORG + 48
CRINIT:         equ ROSORG + 51
PINIT:          equ ROSORG + 54
RAND:           equ ROSORG + 57
