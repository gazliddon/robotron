ERPTR:          RMB      2
;MOVE THIS SOMEDAY
ENFCNT:         RMB      1
GAMTIM:         RMB      1 ; GAME TIMER
TNKSPD:         RMB      1 ; TANK SPEED PARAMETER
SCRFLG:         RMB      1 ; SCORE FLAG
SHLCNT:         RMB      1 ; SHELL COUNTER
RIPFLG:         RMB      1
HCK1:           RMB      1
