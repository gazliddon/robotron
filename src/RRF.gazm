PSINIT:         equ RPORG + 3
PSTP1:          equ RPORG + 6
OPON:           equ RPORG + 8
OPON1:          equ RPORG + 11
SAFTY:          equ RPORG + 14
ROBPIC:         equ RPORG + 17
PSTPIC:         equ RPORG + 19
PKPRCV:         equ RPORG + 21
;
;TRANSPORTER
;
RTORG: equ $4140
TRANST:         equ RTORG + 0
;
;DIAGONAL EXPLOSIONS
;
RDXORG: equ $4680
