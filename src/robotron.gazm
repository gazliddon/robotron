;; Write ROMs
writebin "$(OUT_DIR)/01", $0000, $1000
writebin "$(OUT_DIR)/02", $1000, $1000
writebin "$(OUT_DIR)/03", $2000, $1000
writebin "$(OUT_DIR)/04", $3000, $1000
writebin "$(OUT_DIR)/05", $4000, $1000
